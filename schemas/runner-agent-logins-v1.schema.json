{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.usefulmachinery.com/schemas/runner-agent-logins-v1.schema.json",
  "title": "Useful Machinery Runner Agent-Login Readiness V1",
  "description": "Each provider's readiness on a runner and the record of what the runner installed. It holds no login material.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "providers"],
  "$defs": {
    "installable": {
      "description": "A coding agent whose login a runner installs. A provider other than claude_code and codex, and its state, are a newer runner's, which an older runner keeps as written.",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "state"],
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "not": { "enum": ["github", "gitlab", "linear"] }
        },
        "state": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
        "agentLoginId": { "type": "string", "pattern": "^agl_[0-7][0-9a-hjkmnp-tv-z]{25}$" },
        "generation": { "type": "integer", "minimum": 1 },
        "checkedAt": { "type": "string", "format": "date-time" },
        "installedAt": { "type": "string", "format": "date-time" },
        "installedPath": { "type": "string", "pattern": "^/" },
        "selected": {
          "description": "Whether Cloud's last answer named an authorization in force for the provider: authorized, unauthorized or unsupported_target. An entry without it, written before it was recorded, is selected exactly when its state is ready, foreign_login, unsupported_target, stale_generation, cloud_unavailable or install_failed.",
          "type": "boolean"
        },
        "lastUse": {
          "description": "How the provider answered the last use of the login installed: accepted when an agent step that received its variable finished successfully, refused when one failed with the harness error unauthorized. Recorded only beside an install, with when.",
          "enum": ["accepted", "refused"]
        },
        "lastUseAt": { "type": "string", "format": "date-time" }
      },
      "dependentRequired": {
        "generation": ["agentLoginId", "installedAt", "installedPath"],
        "installedAt": ["generation"],
        "installedPath": ["generation"],
        "lastUse": ["lastUseAt", "generation"],
        "lastUseAt": ["lastUse"]
      },
      "if": { "properties": { "provider": { "enum": ["claude_code", "codex"] } } },
      "then": {
        "properties": {
          "state": {
            "enum": [
              "ready",
              "not_authorized",
              "revoked",
              "foreign_login",
              "unsupported_target",
              "stale_generation",
              "cloud_unavailable",
              "install_failed"
            ]
          }
        }
      }
    },
    "brokered": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "state"],
      "properties": {
        "provider": { "enum": ["github", "gitlab", "linear"] },
        "state": { "const": "not_delivered" }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "providers": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "oneOf": [{ "$ref": "#/$defs/installable" }, { "$ref": "#/$defs/brokered" }]
      }
    }
  }
}
