{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.usefulmachinery.com/schemas/runner-control-v1.schema.json",
  "title": "Useful Machinery Runner Local Control Protocol V1",
  "description": "One closed request or response JSON object. The wire protocol appends exactly one LF and limits requests to 4096 bytes and responses to 65536 bytes, including that LF.",
  "oneOf": [
    { "$ref": "#/$defs/statusRequest" },
    { "$ref": "#/$defs/reloadRequest" },
    { "$ref": "#/$defs/syncAgentLoginsRequest" },
    { "$ref": "#/$defs/statusResponse" },
    { "$ref": "#/$defs/reloadedResponse" },
    { "$ref": "#/$defs/agentLoginsSyncedResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "statusRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "operation"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "status" }
      }
    },
    "reloadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "operation"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "reload_credential" }
      }
    },
    "syncAgentLoginsRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "operation"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "operation": { "const": "sync_agent_logins" }
      }
    },
    "assignmentCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preparing", "accepted", "running", "finishing", "reporting"],
      "properties": {
        "preparing": { "enum": [0, 1] },
        "accepted": { "enum": [0, 1] },
        "running": { "enum": [0, 1] },
        "finishing": { "enum": [0, 1] },
        "reporting": { "enum": [0, 1] }
      },
      "not": {
        "anyOf": [
          { "required": ["preparing", "accepted"], "properties": { "preparing": { "const": 1 }, "accepted": { "const": 1 } } },
          { "required": ["preparing", "running"], "properties": { "preparing": { "const": 1 }, "running": { "const": 1 } } },
          { "required": ["preparing", "finishing"], "properties": { "preparing": { "const": 1 }, "finishing": { "const": 1 } } },
          { "required": ["preparing", "reporting"], "properties": { "preparing": { "const": 1 }, "reporting": { "const": 1 } } },
          { "required": ["accepted", "running"], "properties": { "accepted": { "const": 1 }, "running": { "const": 1 } } },
          { "required": ["accepted", "finishing"], "properties": { "accepted": { "const": 1 }, "finishing": { "const": 1 } } },
          { "required": ["accepted", "reporting"], "properties": { "accepted": { "const": 1 }, "reporting": { "const": 1 } } },
          { "required": ["running", "finishing"], "properties": { "running": { "const": 1 }, "finishing": { "const": 1 } } },
          { "required": ["running", "reporting"], "properties": { "running": { "const": 1 }, "reporting": { "const": 1 } } },
          { "required": ["finishing", "reporting"], "properties": { "finishing": { "const": 1 }, "reporting": { "const": 1 } } }
        ]
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processState", "bootId", "uptimeMilliseconds", "connectionState", "assignmentCounts"],
      "properties": {
        "processState": { "enum": ["running", "stopping"] },
        "bootId": { "type": "string", "pattern": "^rbt_[0-7][0-9a-hjkmnp-tv-z]{25}$" },
        "uptimeMilliseconds": { "type": "integer", "minimum": 0 },
        "connectionState": { "enum": ["connecting", "connected", "backing_off", "authentication_failed", "protocol_failed", "stopping"] },
        "lastConnectedAt": { "type": "string", "format": "date-time" },
        "currentCredentialId": { "type": "string", "pattern": "^rrc_[0-7][0-9a-hjkmnp-tv-z]{25}$" },
        "pendingCredentialId": { "type": "string", "pattern": "^rrc_[0-7][0-9a-hjkmnp-tv-z]{25}$" },
        "assignmentCounts": { "$ref": "#/$defs/assignmentCounts" },
        "lastConnectionFailure": { "enum": ["network", "rate_limited", "cloud_unavailable", "authentication", "protocol"] },
        "agentLogins": { "$ref": "#/$defs/agentLoginReadiness" }
      }
    },
    "agentLoginReadiness": {
      "description": "Each provider's readiness as the runner last recorded it in runner-agent-logins-v1, without the path of an install.",
      "type": "object",
      "additionalProperties": false,
      "required": ["updatedAt", "providers"],
      "properties": {
        "updatedAt": { "type": "string", "format": "date-time" },
        "providers": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "oneOf": [{ "$ref": "#/$defs/installableAgentLogin" }, { "$ref": "#/$defs/brokeredAgentLogin" }]
          }
        }
      }
    },
    "installableAgentLogin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "state"],
      "properties": {
        "provider": { "enum": ["claude_code", "codex"] },
        "state": {
          "enum": [
            "ready",
            "not_authorized",
            "revoked",
            "foreign_login",
            "unsupported_target",
            "stale_generation",
            "cloud_unavailable",
            "install_failed"
          ]
        },
        "agentLoginId": { "type": "string", "pattern": "^agl_[0-7][0-9a-hjkmnp-tv-z]{25}$" },
        "generation": { "type": "integer", "minimum": 1 },
        "checkedAt": { "type": "string", "format": "date-time" },
        "installedAt": { "type": "string", "format": "date-time" },
        "selected": {
          "description": "Whether the provider is selected, as the readiness document records it; absent where it records none.",
          "type": "boolean"
        },
        "lastUse": {
          "description": "How the provider answered the last use of the login installed, as the readiness document records it.",
          "enum": ["accepted", "refused"]
        },
        "lastUseAt": {
          "description": "When that last use was, as the readiness document records it; absent where a serving process that predates it answers.",
          "type": "string",
          "format": "date-time"
        }
      },
      "dependentRequired": {
        "generation": ["agentLoginId", "installedAt"],
        "installedAt": ["generation"],
        "lastUse": ["generation"],
        "lastUseAt": ["lastUse"]
      }
    },
    "brokeredAgentLogin": {
      "description": "An OAuth provider's entry as the readiness document records it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "state"],
      "properties": {
        "provider": { "enum": ["github", "gitlab", "linear"] },
        "state": {
          "enum": [
            "not_delivered",
            "ready",
            "not_authorized",
            "revoked",
            "reconnect_required",
            "unsupported_target",
            "cloud_unavailable",
            "install_failed"
          ]
        },
        "grantId": { "type": "string", "pattern": "^pgr_[0-7][0-9a-hjkmnp-tv-z]{25}$" },
        "generation": { "type": "integer", "minimum": 1 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "checkedAt": { "type": "string", "format": "date-time" },
        "selected": {
          "description": "Whether the provider is selected, as the readiness document records it; absent where it records none.",
          "type": "boolean"
        },
        "runId": {
          "description": "The run of the assignment the entry was recorded for, as the readiness document records it; absent where it records none.",
          "type": "string",
          "pattern": "^run_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "endedAt": {
          "description": "When that assignment ended, as the readiness document records it; absent while it runs, and where a serving process that predates it answers.",
          "type": "string",
          "format": "date-time"
        }
      },
      "dependentRequired": {
        "runId": ["checkedAt"],
        "endedAt": ["checkedAt"]
      },
      "if": { "properties": { "state": { "const": "ready" } } },
      "then": { "required": ["grantId", "generation", "expiresAt"] },
      "else": {
        "properties": { "grantId": false, "generation": false, "expiresAt": false }
      }
    },
    "statusResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "outcome", "status"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "outcome": { "const": "ok" },
        "status": { "$ref": "#/$defs/status" }
      }
    },
    "reloadedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "outcome", "credentialId"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "outcome": { "const": "reloaded" },
        "credentialId": { "type": "string", "pattern": "^rrc_[0-7][0-9a-hjkmnp-tv-z]{25}$" }
      }
    },
    "agentLoginsSyncedResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "outcome", "agentLogins"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "outcome": { "const": "synced" },
        "agentLogins": { "$ref": "#/$defs/agentLoginReadiness" },
        "unansweredChecks": {
          "description": "Each installed login whose check in the setup gave no answer, with why; absent when there is none.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/unansweredCheck" }
        }
      }
    },
    "unansweredCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "cause"],
      "properties": {
        "provider": { "enum": ["claude_code", "codex"] },
        "cause": { "enum": ["program_unavailable", "start_failed", "timed_out", "harness_error"] }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "outcome", "error"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "outcome": { "const": "error" },
        "error": {
          "enum": [
            "invalid_request",
            "unsupported_version",
            "runner_busy",
            "no_pending_credential",
            "pending_registration_mismatch",
            "pending_authentication_failed",
            "pending_protocol_failed",
            "pending_connection_failed",
            "state_update_failed"
          ]
        }
      }
    }
  }
}
