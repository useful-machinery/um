{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.usefulmachinery.com/schemas/workflow-run-result-v1.schema.json",
  "title": "Useful Machinery Workflow Run Result Schema 1",
  "oneOf": [
    {
      "$ref": "#/$defs/CompletedAttempt"
    },
    {
      "$ref": "#/$defs/WorkflowRejection"
    },
    {
      "$ref": "#/$defs/TreeRejection"
    },
    {
      "$ref": "#/$defs/DefinitionRejection"
    },
    {
      "$ref": "#/$defs/AttemptRejection"
    },
    {
      "$ref": "#/$defs/ContinuationRefusal"
    },
    {
      "$ref": "#/$defs/UnattemptedResume"
    },
    {
      "$ref": "#/$defs/SuccessorRefusal"
    },
    {
      "$ref": "#/$defs/UpgradedRun"
    }
  ],
  "$defs": {
    "AbsolutePath": {
      "$ref": "workflow-view-result-v1.schema.json#/$defs/AbsolutePath"
    },
    "RelativePath": {
      "$ref": "workflow-view-result-v1.schema.json#/$defs/RelativePath"
    },
    "AttemptNumber": {
      "type": "integer",
      "minimum": 1
    },
    "Code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "Message": {
      "type": "string",
      "minLength": 1
    },
    "CompletedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "outcome",
        "exitStatus",
        "runDirectory",
        "attemptNumber",
        "resultDirectory",
        "result"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "enum": [
            "um workflow run create",
            "um workflow run retry",
            "um workflow run resume",
            "um workflow run restart"
          ]
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled",
            "waiting",
            "continued"
          ]
        },
        "exitStatus": {
          "enum": [
            0,
            1,
            130,
            143
          ]
        },
        "runDirectory": {
          "$ref": "#/$defs/AbsolutePath"
        },
        "attemptNumber": {
          "$ref": "#/$defs/AttemptNumber"
        },
        "resultDirectory": {
          "$ref": "#/$defs/AbsolutePath"
        },
        "result": {
          "$ref": "workflow-view-result-v1.schema.json#/$defs/WorkflowResult"
        },
        "wait": {
          "$ref": "workflow-view-result-v1.schema.json#/$defs/WaitRecord"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "waiting"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "then": {
            "required": [
              "wait"
            ]
          },
          "else": {
            "not": {
              "required": [
                "wait"
              ]
            }
          }
        }
      ]
    },
    "UnattemptedResume": {
      "description": "A resume without --from, or a retry of a run waiting for repair, that created no attempt: a wait no control resolves, with its record, or a run a control withdrew.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "outcome",
        "exitStatus",
        "runDirectory",
        "attemptNumber"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "enum": [
            "um workflow run resume",
            "um workflow run retry"
          ]
        },
        "outcome": {
          "enum": [
            "waiting",
            "withdrawn"
          ]
        },
        "exitStatus": {
          "const": 0
        },
        "runDirectory": {
          "$ref": "#/$defs/AbsolutePath"
        },
        "attemptNumber": {
          "$ref": "#/$defs/AttemptNumber"
        },
        "wait": {
          "$ref": "workflow-view-result-v1.schema.json#/$defs/WaitRecord"
        }
      },
      "if": {
        "properties": {
          "outcome": {
            "const": "waiting"
          }
        }
      },
      "then": {
        "required": [
          "wait"
        ]
      },
      "else": {
        "not": {
          "required": [
            "wait"
          ]
        }
      }
    },
    "RejectionLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/Code"
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "finalizer": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "output": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executablePath": {
          "type": "string",
          "minLength": 1
        },
        "export": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RejectionDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "location"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "location": {
          "$ref": "#/$defs/RejectionLocation"
        }
      }
    },
    "RejectedWorkflow": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/RelativePath"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "TreeRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "outcome",
        "exitStatus",
        "phase",
        "workflow",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "enum": [
            "um workflow run create",
            "um workflow run retry",
            "um workflow run resume",
            "um workflow run restart",
            "um workflow run upgrade"
          ]
        },
        "outcome": {
          "const": "rejected"
        },
        "exitStatus": {
          "const": 1
        },
        "phase": {
          "const": "tree"
        },
        "runDirectory": {
          "$ref": "#/$defs/AbsolutePath"
        },
        "workflow": {
          "$ref": "#/$defs/RejectedWorkflow"
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/TreeRejectionDiagnostic"
          }
        }
      },
      "if": {
        "properties": {
          "command": {
            "const": "um workflow run create"
          }
        },
        "required": [
          "command"
        ]
      },
      "then": {
        "not": {
          "required": [
            "runDirectory"
          ]
        }
      },
      "else": {
        "required": [
          "runDirectory"
        ]
      }
    },
    "DefinitionRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "outcome",
        "exitStatus",
        "phase",
        "workflow",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "enum": [
            "um workflow run create",
            "um workflow run restart",
            "um workflow run upgrade"
          ]
        },
        "outcome": {
          "const": "rejected"
        },
        "exitStatus": {
          "const": 1
        },
        "phase": {
          "const": "definition"
        },
        "workflow": {
          "type": "null"
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/DefinitionRejectionDiagnostic"
          }
        }
      }
    },
    "DefinitionRejectionDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "run": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "TreeRejectionDiagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "location"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "message": {
          "$ref": "#/$defs/Message"
        },
        "location": {
          "$ref": "#/$defs/TreeRejectionLocation"
        },
        "workflowLocation": {
          "$ref": "#/$defs/RejectionLocation"
        }
      }
    },
    "TreeRejectionLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/Code"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "step": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "binding": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "string",
          "minLength": 1
        },
        "program": {
          "type": "string",
          "minLength": 1
        },
        "pattern": {
          "type": "string"
        },
        "expectedDigest": {
          "$ref": "#/$defs/TreeDigest"
        },
        "actualDigest": {
          "oneOf": [
            {
              "$ref": "#/$defs/TreeDigest"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TreeDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "WorkflowRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "outcome",
        "exitStatus",
        "phase",
        "workflow",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "enum": [
            "um workflow run create",
            "um workflow run retry"
          ]
        },
        "outcome": {
          "const": "rejected"
        },
        "exitStatus": {
          "const": 1
        },
        "phase": {
          "enum": [
            "resolution",
            "installation",
            "admission"
          ]
        },
        "runDirectory": {
          "$ref": "#/$defs/AbsolutePath"
        },
        "workflow": {
          "$ref": "#/$defs/RejectedWorkflow"
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/RejectionDiagnostic"
          }
        }
      },
      "if": {
        "properties": {
          "command": {
            "const": "um workflow run retry"
          }
        },
        "required": [
          "command"
        ]
      },
      "then": {
        "required": [
          "runDirectory"
        ]
      },
      "else": {
        "not": {
          "required": [
            "runDirectory"
          ]
        }
      }
    },
    "AttemptLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "attemptNumber"
      ],
      "properties": {
        "kind": {
          "const": "attempt"
        },
        "attemptNumber": {
          "$ref": "#/$defs/AttemptNumber"
        },
        "guardIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ownershipReason": {
          "enum": [
            "execution_host_identity_unavailable",
            "process_identity_inspection_unavailable"
          ]
        }
      }
    },
    "AttemptRejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "outcome",
        "exitStatus",
        "phase",
        "runDirectory",
        "attemptNumber",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "enum": [
            "um workflow run retry",
            "um workflow run resume",
            "um workflow run restart",
            "um workflow run upgrade"
          ]
        },
        "outcome": {
          "const": "rejected"
        },
        "exitStatus": {
          "const": 1
        },
        "phase": {
          "enum": [
            "retry",
            "continuation"
          ]
        },
        "runDirectory": {
          "$ref": "#/$defs/AbsolutePath"
        },
        "attemptNumber": {
          "$ref": "#/$defs/AttemptNumber"
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "location"
            ],
            "properties": {
              "code": {
                "$ref": "#/$defs/Code"
              },
              "message": {
                "$ref": "#/$defs/Message"
              },
              "location": {
                "$ref": "#/$defs/AttemptLocation"
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "command": {
              "const": "um workflow run retry"
            },
            "phase": {
              "const": "retry"
            }
          }
        },
        {
          "properties": {
            "command": {
              "enum": [
                "um workflow run resume",
                "um workflow run restart",
                "um workflow run upgrade"
              ]
            },
            "phase": {
              "const": "continuation"
            }
          }
        }
      ]
    },
    "ContinuationViolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "location"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/Code"
        },
        "location": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id"
              ],
              "properties": {
                "kind": {
                  "const": "from_step"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "id",
                "priorState"
              ],
              "properties": {
                "kind": {
                  "const": "step"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "priorState": {
                  "enum": [
                    "succeeded",
                    "skipped",
                    "inherited",
                    "unsatisfied",
                    null
                  ]
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "consumer",
                "producer"
              ],
              "properties": {
                "kind": {
                  "const": "required_skipped"
                },
                "consumer": {
                  "type": "string",
                  "minLength": 1
                },
                "producer": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "reference"
              ],
              "properties": {
                "kind": {
                  "const": "reference"
                },
                "reference": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "name"
              ],
              "properties": {
                "kind": {
                  "const": "input"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "SuccessorRefusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "outcome",
        "exitStatus",
        "phase",
        "runDirectory",
        "workflow",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "enum": [
            "um workflow run restart",
            "um workflow run upgrade"
          ]
        },
        "outcome": {
          "const": "rejected"
        },
        "exitStatus": {
          "const": 1
        },
        "phase": {
          "const": "successor"
        },
        "runDirectory": {
          "$ref": "#/$defs/AbsolutePath"
        },
        "workflow": {
          "type": "null"
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "$ref": "#/$defs/Code"
              },
              "message": {
                "$ref": "#/$defs/Message"
              },
              "run": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "UpgradedRun": {
      "description": "A successor um workflow run upgrade created on the definition's current revision, waiting on its predecessor's wait; no attempt was started.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "outcome",
        "exitStatus",
        "runDirectory",
        "run",
        "predecessor",
        "wait"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "const": "um workflow run upgrade"
        },
        "outcome": {
          "const": "upgraded"
        },
        "exitStatus": {
          "const": 0
        },
        "runDirectory": {
          "$ref": "#/$defs/AbsolutePath"
        },
        "run": {
          "type": "string",
          "minLength": 1
        },
        "predecessor": {
          "type": "string",
          "minLength": 1
        },
        "wait": {
          "$ref": "workflow-view-result-v1.schema.json#/$defs/WaitRecord"
        }
      }
    },
    "ContinuationRefusal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "command",
        "outcome",
        "exitStatus",
        "phase",
        "runDirectory",
        "attemptNumber",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "command": {
          "enum": [
            "um workflow run resume",
            "um workflow run restart",
            "um workflow run upgrade"
          ]
        },
        "outcome": {
          "const": "rejected"
        },
        "exitStatus": {
          "const": 1
        },
        "phase": {
          "const": "continuation"
        },
        "runDirectory": {
          "$ref": "#/$defs/AbsolutePath"
        },
        "attemptNumber": {
          "$ref": "#/$defs/AttemptNumber"
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/ContinuationViolation"
              },
              {
                "$ref": "#/$defs/RejectionDiagnostic"
              }
            ]
          }
        }
      }
    }
  }
}
