{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.usefulmachinery.com/schemas/runner-operator-config-v1.schema.json",
  "title": "Useful Machinery Runner Operator Configuration V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "deploymentMode", "runnerStatePath", "controlSocketPath", "workRoot"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "deploymentMode": { "enum": ["production", "development"] },
    "runnerStatePath": { "type": "string", "pattern": "^/" },
    "controlSocketPath": { "type": "string", "pattern": "^/" },
    "workRoot": { "type": "string", "pattern": "^/" }
  }
}
