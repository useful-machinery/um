#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  exit 0
fi

public_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
package_root=$public_root/crates/execution/src/workflow/pi-json-v1-extension
install_root=$(mktemp -d "${TMPDIR:-/tmp}/um-pi-json-v1-format.XXXXXX")

cleanup() {
  rm -rf -- "$install_root"
}
trap cleanup EXIT

cp \
  "$package_root/package.json" \
  "$package_root/package-lock.json" \
  "$install_root/"
(
  cd "$install_root"
  npm ci --ignore-scripts --no-audit --no-fund
)
npm_config_offline=true \
  "$install_root/node_modules/.bin/prettier" --write -- "$@"
