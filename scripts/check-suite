#!/usr/bin/env bash
set -euo pipefail

public_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)

cargo_target_dir=${CARGO_TARGET_DIR:-$public_root/target}
if [[ $cargo_target_dir != /* ]]; then
  cargo_target_dir=$public_root/$cargo_target_dir
fi

snapshot_cli_tree() {
  local destination=$1

  python3 - "$public_root" "$cargo_target_dir" "$destination" <<'PY'
import json
import os
from pathlib import Path
import stat
import sys

root = Path(os.path.realpath(sys.argv[1]))
excluded = Path(os.path.realpath(sys.argv[2]))
destination = Path(sys.argv[3])
entries = []


def visit(directory: Path) -> None:
    with os.scandir(directory) as children:
        for child in sorted(children, key=lambda entry: entry.name):
            path = Path(child.path)
            relative = path.relative_to(root)
            parts = relative.parts
            if path == excluded:
                continue
            target_parent = path in excluded.parents and path != root
            known_temporary = (
                parts[0].startswith(".devenv")
                or parts[0] in {".direnv", "result"}
                or parts[0].startswith("result-")
                or "__pycache__" in parts
                or "node_modules" in parts
            )
            if known_temporary:
                continue
            mode = child.stat(follow_symlinks=False).st_mode
            if stat.S_ISDIR(mode):
                kind = "directory"
            elif stat.S_ISREG(mode):
                kind = "file"
            elif stat.S_ISLNK(mode):
                kind = "symlink"
            else:
                kind = "other"
            if not target_parent:
                entries.append((relative.as_posix(), kind))
            if kind == "directory":
                visit(path)


visit(root)
with destination.open("w", encoding="utf-8") as snapshot:
    for relative, kind in sorted(entries):
        snapshot.write(
            json.dumps({"kind": kind, "path": relative}, ensure_ascii=True) + "\n"
        )
PY
}

compare_cli_tree_snapshots() {
  python3 - "$source_snapshot_root/before" "$source_snapshot_root/after" <<'PY'
import json
from pathlib import Path
import sys

before = set(Path(sys.argv[1]).read_text(encoding="utf-8").splitlines())
after = set(Path(sys.argv[2]).read_text(encoding="utf-8").splitlines())
additions = sorted(
    (json.loads(encoded) for encoded in after - before),
    key=lambda entry: (entry["path"], entry["kind"]),
)
if additions:
    print(
        "CLI test source isolation check: test suite left new source-tree entries:",
        file=sys.stderr,
    )
    for entry in additions:
        print(f"  {entry['kind']}: {entry['path']}", file=sys.stderr)
    raise SystemExit(1)
PY
}

# The clean test boundary preserves TMPDIR, which may be inside this checkout.
# Keep suite support files and the TMPDIR passed to Cargo in a source-external root.
suite_temporary_root=$(mktemp -d "/tmp/scherzo-cli-check-suite.XXXXXX")
source_snapshot_root=
long_tmp_parent=
source_snapshot_started=false
background_names=()
background_pids=()
background_output_root=

# Wait for every background check, print each one's output, and name each
# failed check with its output on standard error. Fails if any check failed.
finish_background_checks() {
  local index name failed=0
  for index in "${!background_pids[@]}"; do
    name=${background_names[$index]}
    if wait "${background_pids[$index]}"; then
      cat "$background_output_root/$name"
    else
      printf 'CLI source check failed: %s\n' "$name" >&2
      cat "$background_output_root/$name" >&2
      failed=1
    fi
  done
  background_names=()
  background_pids=()
  return "$failed"
}

cleanup() {
  local status=$?
  local snapshot_status
  trap - EXIT
  set +e
  # A failed foreground command must not hide a background failure, and the
  # source snapshot and temporary-root removal must follow every writer.
  if ((${#background_pids[@]} > 0)) && ! finish_background_checks; then
    status=1
  fi
  if [[ $source_snapshot_started == true ]]; then
    snapshot_cli_tree "$source_snapshot_root/after"
    snapshot_status=$?
    if [[ $snapshot_status -ne 0 ]]; then
      echo "CLI test source isolation check: could not capture the final source tree." >&2
      status=1
    elif ! compare_cli_tree_snapshots; then
      status=1
    fi
  fi
  # Some nested workflow fixtures deliberately seal their retained input
  # directories read-only. Restore traversal and removal rights only within
  # this suite-owned temporary tree; find does not follow its TMPDIR alias.
  if ! find "$suite_temporary_root" -type d -exec chmod u+rwx {} +; then
    status=1
  fi
  if ! rm -rf "$suite_temporary_root"; then
    status=1
  fi
  exit "$status"
}
trap cleanup EXIT

suite_temporary_physical=$(cd "$suite_temporary_root" && pwd -P)
case "$suite_temporary_physical/" in
  "$public_root/"*)
    echo "CLI test source isolation check: temporary root is inside the CLI source tree." >&2
    exit 1
    ;;
esac
case "$public_root/" in
  "$suite_temporary_physical/"*)
    echo "CLI test source isolation check: temporary root contains the CLI source tree." >&2
    exit 1
    ;;
esac

source_snapshot_root=$suite_temporary_physical/snapshots
long_tmp_parent=$suite_temporary_physical/work
mkdir -m 700 "$source_snapshot_root" "$long_tmp_parent"
snapshot_cli_tree "$source_snapshot_root/before"
source_snapshot_started=true
long_tmp_physical="$long_tmp_parent/physical/portable-workflow-test-temporary-directory/with-a-deliberately-long-path/to-detect-path-length-dependent-test-fixtures"
tmp_alias="$long_tmp_parent/t"
mkdir -p "$long_tmp_physical"
chmod 700 "$long_tmp_physical"
# Exercise the lexical-versus-resolved path distinction on every platform,
# including Linux where /tmp is ordinarily not an alias. Keep the lexical path
# short enough for Unix-domain sockets while retaining a long physical target.
ln -s "$long_tmp_physical" "$tmp_alias"
# Do not let any suite command honor an inherited TMPDIR inside the checkout.
export TMPDIR=$tmp_alias

# The source checks are mostly single-threaded and need nothing that Cargo
# builds, while the Cargo phases below leave cores idle as tests run. Run them
# beside Cargo, longest first, each with its own output file and its own
# directory beneath the suite TMPDIR. The suite reports them after Cargo, or
# on any earlier exit, and fails if any failed.
background_output_root=$long_tmp_parent/background-output
mkdir -m 700 "$background_output_root"
start_background_check() {
  local name=$1 temporary=$tmp_alias/c${#background_pids[@]}
  shift
  mkdir -m 700 "$temporary"
  TMPDIR=$temporary "$@" >"$background_output_root/$name" 2>&1 &
  background_names+=("$name")
  background_pids+=("$!")
}
start_background_check check-structure "$public_root/scripts/check-structure"
start_background_check check-pi-json-v1-extension \
  "$public_root/scripts/check-pi-json-v1-extension"
# Devenv keys its evaluation cache on TMPDIR, and the suite alias is new on
# every run. The boundary test is the only Devenv entry here, so give it a
# fixed source-external TMPDIR; the clean boundary does not keep TMPDIR.
start_background_check test-strict-devenv \
  env TMPDIR=/tmp "$public_root/scripts/test-strict-devenv"
start_background_check check-help-output-style \
  "$public_root/scripts/check-help-output-style"
start_background_check check-public-api-boundary \
  "$public_root/scripts/check-public-api-boundary"

cd "$public_root"
export CARGO_TERM_COLOR=never
# Incremental state pays off only in a target that a later check reuses for the
# same source path; rustc keeps one session per crate there and discards older
# ones. A cold checkout would only spend disk and time writing it, so it stays
# off unless the caller that owns a persistent, size-bounded target enables it.
export CARGO_INCREMENTAL=${CARGO_INCREMENTAL:-0}
cargo fmt --all -- --check
"$public_root/scripts/check-msrv"
cargo clippy --locked --workspace --all-targets --all-features -- -D warnings
"$public_root/scripts/check-lint-policy"
# A caller that already builds and runs this suite on the same source, such as
# the private pipeline's cli-nix step, names itself in UM_CLI_SUITE_TESTS_RUN_BY.
# The source, format, MSRV and lint checks above still run; the workspace
# build, the test run and the release-archive check that reuses its binary do
# not. The public workflow never sets the variable, so its suite stays complete.
tests_run_by=${UM_CLI_SUITE_TESTS_RUN_BY:-}
if [[ -n $tests_run_by ]]; then
  printf 'Workspace build, nextest run and release-archive check skipped: run by %s on this source.\n' \
    "$tests_run_by"
else
  # --all-targets builds the example as a test harness, not as a worker.
  # Build the ordinary executable before exporting its explicit test contract.
  # Match the test run's packages and features, and build the binaries the
  # integration tests need anyway: a build-time dependency that the command
  # binary also links is otherwise built with a host-only profile, and every
  # library above it, including the worker's, would compile a second time.
  cargo build --locked --workspace --all-features --bins --example internal-worker
  export UM_TEST_INTERNAL_WORKER_EXECUTABLE="$cargo_target_dir/debug/examples/internal-worker"
  # Nextest normally re-executes itself before each test process. That second
  # exec costs about 65 ms per test on macOS, roughly 15 s across this suite, and
  # only guards an interactive job-control race that this noninteractive check
  # never meets.
  # On macOS many tests wait on child processes, so run about 1.6 test threads
  # per CPU there (16 on a 10-CPU host); see .config/nextest.toml. Linux hosts
  # keep nextest's one thread per CPU.
  if [[ $(uname -s) == Darwin ]]; then
    # A separate assignment, so that a failed count stops the suite.
    online_cpus=$(nproc)
    export NEXTEST_TEST_THREADS=$((online_cpus * 8 / 5))
  fi
  NEXTEST_DOUBLE_SPAWN=0 cargo nextest run --locked --workspace --all-targets --all-features

  # The packaging checks exercise archive layout, embedded authoring assets, and
  # isolated execution, none of which depend on optimization level. Reuse the
  # binary the integration tests just built instead of a second, optimized
  # compilation of the whole crate; the Nix package and release builds compile
  # optimized binaries with the injected version and identity and run this suite
  # against them. Those publication paths keep the packager's maximum default
  # compression; this layout check packs the large debug binary at the fastest
  # level, which changes only the compressed bytes.
  host_target=$(rustc -vV | awk '$1 == "host:" { print $2 }')
  case $host_target in
    aarch64-apple-darwin | aarch64-unknown-linux-gnu | x86_64-unknown-linux-gnu)
      release_dist=$long_tmp_parent/release-dist
      archive=$(
        "$public_root/scripts/package-release-archive" \
          --binary "$cargo_target_dir/debug/um" \
          --output "$release_dist" \
          --target "$host_target" \
          --version 0.0.0-dev \
          --compression-level 1
      )
      "$public_root/scripts/verify-release-package-isolated" \
        --archive "$archive" \
        --target "$host_target" \
        --version 0.0.0-dev
      ;;
    *)
      printf 'Skipped release-package execution on unsupported host target: %s\n' \
        "$host_target"
      ;;
  esac
fi

finish_background_checks

printf 'Public CLI source checks passed.\n'
