#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
public_root=$(cd -- "$script_dir/.." && pwd -P)

usage() {
  cat >&2 <<'EOF'
Usage: scripts/strict-devenv DEVENV_ARGUMENT...
EOF
}

fail() {
  printf 'strict-devenv: %s\n' "$*" >&2
  exit 2
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  usage
  exit 0
fi
[[ $# -gt 0 ]] || {
  usage
  exit 2
}

devenv_binary=$(type -P devenv || true)
if [[ -z $devenv_binary ]]; then
  devenv_binary=${UM_STRICT_DEVENV_BINARY:-}
fi
[[ $devenv_binary == /* && -x $devenv_binary ]] \
  || fail "devenv is required to enter the clean test environment"

# The exported source has no parent wrapper. Retain only values required by its
# test contract and the exact Devenv binary used by nested boundary tests.
# CARGO_HOME and CARGO_TARGET_DIR let a caller-owned persistent registry and
# build cache survive the boundary instead of recompiling from cold each run.
keep_variables=(
  CARGO_BUILD_JOBS
  CARGO_HOME
  CARGO_TARGET_DIR
  CI
  DEVENV_TUI
  HOME
  RUSTC_WRAPPER
  UM_STRICT_DEVENV_BINARY
)
printf -v keep_list '%s,' "${keep_variables[@]}"
keep_list=${keep_list%,}

export UM_STRICT_DEVENV_BINARY=$devenv_binary
cd -- "$public_root"
exec "$devenv_binary" "--clean=$keep_list" "$@"
