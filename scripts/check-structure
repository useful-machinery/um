#!/usr/bin/env bash
set -euo pipefail

public_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

required_files=(
  README.md
  ARCHITECTURE.md
  AGENTS.md
  CONTRIBUTING.md
  SECURITY.md
  LICENSE
  .config/nextest.toml
  changes/README.md
  docs/workflow-v1.md
  release.toml
  schemas/workflow-status-result-v1.schema.json
  schemas/workflow-v1.schema.json
  schemas/workflow-view-result-v1.schema.json
  tests/fixtures/workflow-view/v1/valid/success-current.json
  tests/fixtures/workflow-view/v1/valid/error-operational.json
  tests/fixtures/workflow-view/v1/valid/error-attempt.json
  tests/fixtures/workflow-view/v1/invalid/success-extra-property.json
  tests/fixtures/workflow-view/v1/invalid/success-inconsistent-outcome.json
  tests/fixtures/workflow-view/v1/invalid/error-operational-attempt-identity.json
  tests/fixtures/workflow-view/v1/invalid/error-attempt-missing-identity.json
  tests/fixtures/workflow-view/v1/invalid/error-empty-message.json
  .github/workflows/check.yml
  Cargo.toml
  Cargo.lock
  clippy.toml
  devenv.nix
  devenv.yaml
  devenv.lock
  scripts/check
  scripts/check-suite
  scripts/check-change-fragments
  scripts/check-help-output-style
  scripts/check-lint-policy
  scripts/check-msrv
  scripts/check-pi-json-v1-extension
  scripts/check-public-api-boundary
  scripts/check-structure
  scripts/strict-devenv
  scripts/test-strict-devenv
  scripts/classify-release-path
  scripts/format-pi-json-v1-extension
  scripts/package-release-archive
  scripts/reconcile-release
  scripts/release-impact
  scripts/test-change-fragments
  scripts/test-release-candidate
  scripts/test-release-impact
  scripts/test-release-package
  scripts/test-release-path-classifier
  scripts/test-public-api-boundary
  scripts/verify-release-candidate
  scripts/verify-release-package
  scripts/verify-release-package-isolated
  crates/execution/Cargo.toml
  crates/execution/src/lib.rs
  crates/execution/src/process.rs
  crates/human-auth/Cargo.toml
  crates/human-auth/src/lib.rs
  crates/execution/src/workflow/pi-json-v1-extension/package.json
  crates/execution/src/workflow/pi-json-v1-extension/package-lock.json
  crates/execution/src/workflow/pi-json-v1-extension/tsconfig.json
  crates/execution/src/workflow/pi-json-v1-extension/fixtures/generated/pi-json-v1-extension.ts
  crates/execution/src/workflow/pi-json-v1-extension/src/pi-json-v1-extension.ts
  crates/api/Cargo.toml
  crates/api/src/lib.rs
  crates/api/src/generated/mod.rs
  crates/runner/Cargo.toml
  crates/runner/src/lib.rs
  crates/runner-protocol/Cargo.toml
  crates/runner-protocol/src/lib.rs
  crates/runner-protocol/src/generated.rs
  crates/support/Cargo.toml
  crates/support/src/lib.rs
  crates/support/src/timing.rs
  crates/test-support/Cargo.toml
  crates/test-support/src/lib.rs
  tests/fixtures/lint-policy/broadly_suppressed.rs
  tests/fixtures/lint-policy/main.rs
  tests/fixtures/lint-policy/ordinary_production.rs
  tests/fixtures/lint-policy/ordinary_test.rs
)

for required_file in "${required_files[@]}"; do
  if [[ ! -s "$public_root/$required_file" ]]; then
    echo "Required public source file is missing or empty: $required_file" >&2
    exit 1
  fi
done

if ! locked_devenv_revision=$(
  jq --exit-status --raw-output '
    .nodes.devenv.locked.rev
    | strings
    | select(test("^[0-9a-f]{40}$"))
  ' "$public_root/devenv.lock"
); then
  echo "devenv.lock must contain a canonical Devenv revision." >&2
  exit 1
fi

mapfile -t workflow_devenv_installs < <(
  grep --fixed-strings \
    'nix profile add github:cachix/devenv/' \
    "$public_root/.github/workflows/check.yml" \
    || true
)
if [[ ${#workflow_devenv_installs[@]} -ne 1 ]]; then
  echo "The public check workflow must contain exactly one direct Devenv installation." >&2
  exit 1
fi
workflow_no_tui_count=$(
  grep --fixed-strings --line-regexp --count \
    '  DEVENV_TUI: "false"' \
    "$public_root/.github/workflows/check.yml" \
    || true
)
if [[ $workflow_no_tui_count -ne 1 ]]; then
  echo "The public check workflow must disable the Devenv TUI." >&2
  exit 1
fi
workflow_devenv_install=${workflow_devenv_installs[0]}
workflow_devenv_install=${workflow_devenv_install#"${workflow_devenv_install%%[![:space:]]*}"}
if [[ $workflow_devenv_install != \
  "run: nix profile add github:cachix/devenv/$locked_devenv_revision" ]]; then
  echo "The public check workflow must install the Devenv revision pinned in devenv.lock." >&2
  exit 1
fi

obsolete_workflow_schema=crates/execution/src/workflow/workflow-v1.schema.json
if [[ -e "$public_root/$obsolete_workflow_schema" ]]; then
  echo "Obsolete internal Workflow V1 schema is present: $obsolete_workflow_schema" >&2
  exit 1
fi

if ! grep --fixed-strings --line-regexp --quiet \
  'disallowed_methods = "deny"' "$public_root/Cargo.toml"; then
  echo "Cargo must deny the checked-in disallowed timing methods by default." >&2
  exit 1
fi

symbolic_link=$(
  find "$public_root" \
    \( -name '.devenv*' -o -name .direnv -o -name node_modules -o -name target \) -prune -o \
    -type l -print -quit
)
if [[ -n "$symbolic_link" ]]; then
  echo "Symbolic links are not permitted in the public source: $symbolic_link" >&2
  exit 1
fi

while IFS= read -r -d '' script_file; do
  IFS= read -r first_line <"$script_file" || true
  if [[ $first_line =~ ^'#!'.*(ba|z|k)?sh([[:space:]]|$) ]]; then
    bash -n "$script_file"
  fi
done < <(find "$public_root/scripts" -type f -print0)

python3 - \
  "$public_root/scripts/package-release-archive" \
  "$public_root/scripts/reconcile-release" \
  "$public_root/scripts/test-release-candidate" \
  "$public_root/scripts/test-release-package" \
  "$public_root/scripts/verify-release-candidate" \
  "$public_root/scripts/verify-release-package" \
  "$public_root/scripts/verify-release-package-isolated" <<'PY'
from pathlib import Path
import sys

for raw_path in sys.argv[1:]:
    path = Path(raw_path)
    compile(path.read_text(), str(path), "exec")
PY

"$public_root/scripts/test-fixture-git"
"$public_root/scripts/test-git-isolation-check"
"$public_root/scripts/check-test-git-isolation"
"$public_root/scripts/test-change-fragments"
"$public_root/scripts/check-change-fragments"
"$public_root/scripts/test-release"
python3 "$public_root/scripts/test-release-candidate"
"$public_root/scripts/test-release-impact"
python3 "$public_root/scripts/test-release-package"
"$public_root/scripts/test-release-path-classifier"
"$public_root/scripts/test-public-api-boundary"
"$public_root/scripts/check-release"

for readme_contract in \
  'um workflow reference' \
  'um workflow schema > workflow-v1.schema.json' \
  'https://docs.usefulmachinery.com/agent/workflow-authoring.md' \
  'https://docs.usefulmachinery.com/reference/workflow-v1.md' \
  'https://docs.usefulmachinery.com/schemas/workflow-v1.schema.json' \
  'https://docs.usefulmachinery.com/openapi/public-api.yaml'; do
  if ! grep --fixed-strings --quiet -- "$readme_contract" "$public_root/README.md"; then
    echo "The public README is missing required guidance: $readme_contract" >&2
    exit 1
  fi
done

if ! command -v actionlint >/dev/null 2>&1; then
  echo "actionlint is required to check public release automation." >&2
  exit 1
fi
actionlint "$public_root/.github/workflows/check.yml"

workspace_manifest=$(
  cargo locate-project \
    --manifest-path "$public_root/Cargo.toml" \
    --workspace \
    --message-format plain
)
workspace_root=$(cd "$(dirname "$workspace_manifest")" && pwd)
if [[ "$workspace_root" != "$public_root" ]]; then
  echo "The Cargo workspace must be rooted inside the public source boundary: $workspace_root" >&2
  exit 1
fi

metadata=$(cargo metadata --locked --no-deps --format-version 1 \
  --manifest-path "$public_root/Cargo.toml")
python3 - "$public_root" "$metadata" <<'PY'
import json
from pathlib import Path
import re
import sys
import tomllib

root = Path(sys.argv[1]).resolve()
metadata = json.loads(sys.argv[2])
packages = {package["id"]: package for package in metadata["packages"]}
workspace_ids = set(metadata["workspace_members"])
member_manifests = {
    Path(packages[identifier]["manifest_path"]).resolve()
    for identifier in workspace_ids
}

for manifest in sorted(member_manifests):
    if root not in manifest.parents and manifest != root / "Cargo.toml":
        raise SystemExit(f"Cargo workspace member escapes the public source: {manifest}")
    text = manifest.read_text(encoding="utf-8")
    if re.search(r"^\s*\[(?:patch(?:\.|\])|replace\])", text, re.MULTILINE):
        document = tomllib.loads(text)
        approved_patch = {
            "crates-io": {
                "rustls-platform-verifier": {"path": "vendor/rustls-platform-verifier"}
            }
        }
        if (
            manifest != root / "Cargo.toml"
            or document.get("patch") != approved_patch
            or "replace" in document
        ):
            raise SystemExit(f"Cargo source overrides are not permitted: {manifest}")

# Both HTTP backends must resolve the exact, self-contained native-verifier fix.
vendor = (root / "vendor/rustls-platform-verifier/Cargo.toml").resolve()
if root not in vendor.parents:
    raise SystemExit("The patched platform verifier escapes the public source boundary")
vendor_manifest = tomllib.loads(vendor.read_text(encoding="utf-8"))
if vendor_manifest["package"]["name"] != "rustls-platform-verifier" or vendor_manifest["package"]["version"] != "0.7.0":
    raise SystemExit("The patched platform verifier package identity changed")
lock = tomllib.loads((root / "Cargo.lock").read_text(encoding="utf-8"))
verifiers = [package for package in lock["package"] if package["name"] == "rustls-platform-verifier"]
if len(verifiers) != 1 or verifiers[0]["version"] != "0.7.0" or "source" in verifiers[0]:
    raise SystemExit("All HTTP backends must use the single patched platform verifier")

for identifier in workspace_ids:
    package = packages[identifier]
    for dependency in package["dependencies"]:
        raw_path = dependency.get("path")
        if raw_path is None:
            continue
        path = Path(raw_path).resolve()
        manifest = path / "Cargo.toml"
        if root not in path.parents or manifest not in member_manifests:
            raise SystemExit(
                "Cargo path dependency must resolve to an in-root workspace member: "
                f"{package['name']} -> {path}"
            )
PY

python3 - "$public_root" <<'PY'
from pathlib import Path
import re
import sys

root = Path(sys.argv[1]).resolve()
source_roots = (root / "src", root / "crates", root / "tests", root / "vendor")
direct = re.compile(r'(?:include(?:_str|_bytes)?!\(|#\[path\s*=)\s*"([^"]+)"')
manifest_relative = re.compile(
    r'env!\("CARGO_MANIFEST_DIR"\)\s*,\s*"([^"]+)"'
)

for source_root in source_roots:
    for source in source_root.rglob("*.rs"):
        text = source.read_text(encoding="utf-8")
        candidates = [(source.parent, value) for value in direct.findall(text)]
        manifest = next(
            (parent / "Cargo.toml" for parent in (source, *source.parents) if (parent / "Cargo.toml").is_file()),
            None,
        )
        if manifest is not None:
            candidates.extend(
                (manifest.parent, value.lstrip("/"))
                for value in manifest_relative.findall(text)
            )
        for base, value in candidates:
            if ".." not in Path(value).parts:
                continue
            resolved = (base / value).resolve()
            if root not in resolved.parents and resolved != root:
                raise SystemExit(
                    f"Rust source imports outside the public boundary: {source}: {value}"
                )
PY

printf 'Public CLI source structure checks passed.\n'
