#!/usr/bin/env bash
set -euo pipefail

public_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$public_root"

# Scan every source in one awk process. Each file is judged independently: an
# item-scoped exception is an #[expect(clippy::disallowed_methods)] attribute
# followed, apart from comments and further attributes, by a function. In
# "first-failure" mode the scan stops at the first file, in argument order,
# that uses #[allow] (checked first) or attaches the expectation to anything
# else, and prints that file's diagnostic. In "report" mode it prints which of
# the two shapes each file contains.
scan_timing_suppressions() {
  local mode=$1
  shift
  awk -v mode="$mode" '
    function reset_file() {
      collecting = 0
      attribute = ""
      awaiting_item = 0
      timing_allow = 0
      broad_expectation = 0
    }
    function finish_file(path) {
      if (awaiting_item) {
        broad_expectation = 1
      }
      if (mode == "report") {
        print path ": timing_allow=" timing_allow " broad_expectation=" broad_expectation
        return
      }
      if (timing_allow) {
        print "Use item-scoped #[expect] for clippy::disallowed_methods exceptions; #[allow] is forbidden: " path > "/dev/stderr"
        failed = 1
        exit 1
      }
      if (broad_expectation) {
        print "Attach clippy::disallowed_methods expectations directly to a function or method, never a crate or module: " path > "/dev/stderr"
        failed = 1
        exit 1
      }
    }
    function inspect_item(line, item) {
      if (!awaiting_item) {
        return
      }

      item = line
      sub(/^[[:space:]]*/, "", item)
      if (item == "" || item ~ /^\/\// || item ~ /^\/\*/ || item ~ /^\*/) {
        return
      }

      if (item ~ /(^|[[:space:]])fn[[:space:]]+(r#)?[[:alpha:]_][[:alnum:]_]*/) {
        awaiting_item = 0
      } else {
        broad_expectation = 1
      }
    }
    function inspect_attribute(line, trailing) {
      if (attribute ~ /allow[[:space:]]*\(/ && attribute ~ /clippy::disallowed_methods/) {
        timing_allow = 1
      }
      if (attribute ~ /expect[[:space:]]*\(/ && attribute ~ /clippy::disallowed_methods/) {
        if (attribute ~ /^[[:space:]]*#!\[/) {
          broad_expectation = 1
        } else {
          awaiting_item = 1
        }
      }

      trailing = line
      sub(/^.*\][[:space:]]*/, "", trailing)
      inspect_item(trailing)
    }
    FNR == 1 {
      if (NR > 1) {
        finish_file(current_file)
      }
      current_file = FILENAME
      reset_file()
    }
    collecting {
      attribute = attribute "\n" $0
      if ($0 ~ /\]/) {
        inspect_attribute($0)
        collecting = 0
      }
      next
    }
    /^[[:space:]]*#(!)?\[/ {
      collecting = 1
      attribute = $0
      if ($0 ~ /\]/) {
        inspect_attribute($0)
        collecting = 0
      }
      next
    }
    {
      inspect_item($0)
    }
    END {
      if (!failed && NR > 0) {
        finish_file(current_file)
      }
    }
  ' "$@"
}

rust_sources=()
while IFS= read -r -d '' rust_source; do
  rust_sources+=("$rust_source")
done < <(
  find src crates tests \
    -path 'tests/fixtures/lint-policy' -prune -o \
    -name '*.rs' -type f -print0
)
# Empty files contain neither shape and produce no awk record, so they need no
# separate pass.
if ((${#rust_sources[@]} > 0)); then
  scan_timing_suppressions first-failure "${rust_sources[@]}"
fi

broad_suppression_fixture=tests/fixtures/lint-policy/main.rs
fixture_report=$(scan_timing_suppressions report "$broad_suppression_fixture")
if [[ $fixture_report != *"timing_allow=1"* ]]; then
  echo "Lint-policy fixture did not exercise an outer module timing allow." >&2
  exit 1
fi
if [[ $fixture_report != *"broad_expectation=1"* ]]; then
  echo "Lint-policy fixture did not exercise an outer module timing expectation." >&2
  exit 1
fi

lint_fixture=$(mktemp -d)
cleanup() {
  rm -rf "$lint_fixture"
}
trap cleanup EXIT

cp clippy.toml "$lint_fixture/"
python3 - "$public_root/Cargo.toml" "$lint_fixture/Cargo.toml" <<'PY'
import json
from pathlib import Path
import sys
import tomllib

source = tomllib.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
workspace = source["workspace"]
package = workspace["package"]
lines = [
    "[package]",
    'name = "scherzo-cloud-lint-policy-fixture"',
    'version = "0.0.0"',
    f"edition = {json.dumps(package['edition'])}",
    f"rust-version = {json.dumps(package['rust-version'])}",
    "publish = false",
]
for group in ("rust", "clippy"):
    lines.extend(("", f"[lints.{group}]"))
    for name, value in workspace["lints"][group].items():
        lines.append(f"{name} = {json.dumps(value)}")
Path(sys.argv[2]).write_text("\n".join(lines) + "\n", encoding="utf-8")
PY
mkdir -p "$lint_fixture/src"
cp tests/fixtures/lint-policy/*.rs "$lint_fixture/src/"

lint_output=$lint_fixture/clippy-output.json
clippy_stderr=$lint_fixture/clippy-stderr
set +e
# Compile the binary test target directly so every intentional violation is
# diagnosed in one compiler invocation. With --all-targets, Cargo may stop after
# the intentionally failing production target before scheduling its cfg(test) target.
CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-$public_root/target} \
  cargo clippy \
    --quiet \
    --manifest-path "$lint_fixture/Cargo.toml" \
    --tests \
    --all-features \
    --message-format=json \
    >"$lint_output" 2>"$clippy_stderr"
clippy_status=$?
set -e

if ((clippy_status == 0)); then
  echo "Clippy accepted representative production and test policy violations." >&2
  exit 1
fi

error_codes=$(
  jq -r '
    select(.reason == "compiler-message" and .message.level == "error")
    | .message.code.code // empty
  ' "$lint_output"
)
for expected_code in \
  dead_code \
  clippy::allow_attributes_without_reason \
  clippy::cast_possible_truncation \
  clippy::disallowed_macros \
  clippy::disallowed_methods \
  clippy::unreachable \
  clippy::unwrap_used; do
  if ! grep --fixed-strings --line-regexp --quiet "$expected_code" <<<"$error_codes"; then
    echo "Clippy did not reject the representative $expected_code violation." >&2
    cat "$clippy_stderr" >&2
    jq -r '
      select(.reason == "compiler-message")
      | .message.rendered // empty
    ' "$lint_output" >&2
    exit 1
  fi
done

timing_violation_files=$(
  jq -r '
    select(
      .reason == "compiler-message"
      and .message.level == "error"
      and .message.code.code == "clippy::disallowed_methods"
    )
    | .message.spans[]
    | select(.is_primary)
    | .file_name
  ' "$lint_output"
)
for expected_source in ordinary_production.rs ordinary_test.rs; do
  if ! grep --extended-regexp --quiet "(^|/)${expected_source//./\\.}$" \
    <<<"$timing_violation_files"; then
    echo "Clippy did not reject the representative direct timing use in $expected_source." >&2
    cat "$clippy_stderr" >&2
    exit 1
  fi
done

ordinary_test_violations=$(
  grep --extended-regexp --count '(^|/)ordinary_test\.rs$' \
    <<<"$timing_violation_files"
)
if ((ordinary_test_violations < 2)); then
  echo "Clippy did not reject both test elapsed-time reads and timeout delays." >&2
  cat "$clippy_stderr" >&2
  exit 1
fi

macro_violation_files=$(
  jq -r '
    select(
      .reason == "compiler-message"
      and .message.level == "error"
      and .message.code.code == "clippy::disallowed_macros"
    )
    | .message.spans[]
    | select(.is_primary)
    | .file_name
  ' "$lint_output"
)
ordinary_production_macro_violations=$(
  grep --extended-regexp --count '(^|/)ordinary_production\.rs$' \
    <<<"$macro_violation_files"
)
if ((ordinary_production_macro_violations < 2)); then
  echo "Clippy did not reject both direct production assert! and eprintln! use." >&2
  cat "$clippy_stderr" >&2
  exit 1
fi

unreachable_violation_files=$(
  jq -r '
    select(
      .reason == "compiler-message"
      and .message.level == "error"
      and .message.code.code == "clippy::unreachable"
    )
    | .message.spans[]
    | select(.is_primary)
    | .file_name
  ' "$lint_output"
)
if ! grep --extended-regexp --quiet '(^|/)ordinary_production\.rs$' \
  <<<"$unreachable_violation_files"; then
  echo "Clippy did not reject representative direct production unreachable! use." >&2
  cat "$clippy_stderr" >&2
  exit 1
fi

printf 'Checked-in Rust lint policy rejects broad timing suppressions, direct elapsed-time reads and timeout delays, and production panic-only invariants and eprintln! use by default.\n'
