#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
boundary=$script_dir/strict-devenv
temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT

fail() {
  printf 'strict-devenv test: %s\n' "$*" >&2
  exit 1
}

ambient_directory=$temporary/ambient-bin
ambient_command=scherzo-cli-ambient-only-command
cargo_target=$temporary/cargo-target
cargo_home=$temporary/cargo-home
marker_value=must-not-cross-clean-boundary
diagnostic=$temporary/missing-command.err
mkdir -p -- "$ambient_directory" "$cargo_target" "$cargo_home"
printf '#!%s\n%s\n' "$BASH" 'exit 0' >"$ambient_directory/$ambient_command"
chmod +x "$ambient_directory/$ambient_command"

# The single-quoted program is evaluated by the clean child shell.
# shellcheck disable=SC2016
if ! PATH="$ambient_directory:$PATH" \
  CARGO_BUILD_JOBS=1 \
  CARGO_HOME="$cargo_home" \
  CARGO_TARGET_DIR="$cargo_target" \
  RUSTC_WRAPPER="$ambient_directory/$ambient_command" \
  DEVENV_TUI=false \
  UM_CLI_STRICT_DEVENV_TEST_MARKER="$marker_value" \
  "$boundary" shell -- bash -c '
    set -euo pipefail
    expected_target=$1
    ambient_directory=$2
    ambient_command=$3
    diagnostic=$4
    [[ ${CARGO_TARGET_DIR:-} == "$expected_target" ]]
    [[ ${CARGO_HOME:-} == "$5" ]]
    [[ ${CARGO_BUILD_JOBS:-} == 1 ]]
    [[ ${RUSTC_WRAPPER:-} == "$ambient_directory/$ambient_command" ]]
    [[ ${DEVENV_TUI:-} == false ]]
    [[ -z ${UM_CLI_STRICT_DEVENV_TEST_MARKER+x} ]]
    [[ :$PATH: != *":$ambient_directory:"* ]]
    ! command -v "$ambient_command" >/dev/null 2>&1
    if "$ambient_command" 2>"$diagnostic"; then
      exit 1
    fi
    [[ $(<"$diagnostic") == *"$ambient_command"* ]]
  ' bash "$cargo_target" "$ambient_directory" "$ambient_command" "$diagnostic" \
    "$cargo_home" \
  >"$temporary/environment.out" 2>"$temporary/environment.err"; then
  cat "$temporary/environment.out" "$temporary/environment.err" >&2
  fail 'clean environment did not enforce the exported CLI test contract'
fi

printf '%s\n' 'Exported CLI strict Devenv boundary test passed.'
