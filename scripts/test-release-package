#!/usr/bin/env python3
"""Mutation tests for deterministic release-package authoring verification."""

from __future__ import annotations

import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Literal


PUBLIC_ROOT = Path(__file__).resolve().parent.parent
PACKAGE = PUBLIC_ROOT / "scripts/package-release-archive"
VERIFY = PUBLIC_ROOT / "scripts/verify-release-package"
VERIFY_ISOLATED = PUBLIC_ROOT / "scripts/verify-release-package-isolated"
TARGET = "x86_64-unknown-linux-gnu"
VERSION = "1.2.3"
REFERENCE = """# Workflow V1 authoring reference

Authoring guide: <https://docs.usefulmachinery.com/agent/workflow-authoring.md>

Full language reference: <https://docs.usefulmachinery.com/reference/workflow-v1.md>

Raw schema: <https://docs.usefulmachinery.com/schemas/workflow-v1.schema.json>
"""
SCHEMA = '{"type":"object"}\n'


def fail(message: str) -> None:
    raise SystemExit(f"test-release-package: {message}")


def run(arguments: list[object], *, check: bool = True) -> subprocess.CompletedProcess[bytes]:
    result = subprocess.run(
        [sys.executable, *(str(argument) for argument in arguments)],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if check and result.returncode != 0:
        fail(f"command failed with status {result.returncode}: {result.stderr.decode()}")
    return result


def write_binary(
    path: Path,
    mutation: Literal[
        "none",
        "missing-command",
        "misleading-help",
        "schema-drift",
        "source-dependent",
        "state-write",
    ],
) -> None:
    schema = SCHEMA if mutation != "schema-drift" else '{"type":"string"}\n'
    if mutation == "misleading-help":
        help_output = (
            b"Work with workflows\n\nNotes:\n"
            b"  reference documentation is available offline\n"
            b"  schema documents describe workflow structure\n"
        )
    else:
        help_output = b"Work with workflows\n\nCommands:\n  reference  Print reference\n"
        if mutation != "missing-command":
            help_output += b"  schema     Print schema\n"

    if mutation == "source-dependent":
        source = path.parent
        reference_output = (
            f'(Path({str(source)!r}) / "docs/workflow-v1.md").read_bytes()'
        )
        schema_output = (
            f'(Path({str(source)!r}) / "schemas/workflow-v1.schema.json").read_bytes()'
        )
    else:
        reference_output = repr(REFERENCE.encode())
        schema_output = repr(schema.encode())

    state_write = ""
    if mutation == "state-write":
        state_write = """
if arguments == ["workflow", "reference"]:
    (Path(os.environ["HOME"]) / "unexpected-state").write_text(
        "unexpected\\n", encoding="utf-8"
    )
"""

    path.write_text(
        f"""#!{sys.executable}
import os
import sys
from pathlib import Path

arguments = sys.argv[1:]
{state_write}
if arguments == ["--version"]:
    output = {f"um {VERSION}\n".encode()!r}
elif arguments == ["workflow", "--help"]:
    output = {help_output!r}
elif arguments == ["workflow", "reference"]:
    output = {reference_output}
elif arguments == ["workflow", "schema"]:
    output = {schema_output}
else:
    raise SystemExit(2)
sys.stdout.buffer.write(output)
""",
        encoding="utf-8",
    )
    path.chmod(0o755)


def create_source(root: Path) -> tuple[Path, Path, Path]:
    scripts = root / "scripts"
    scripts.mkdir(parents=True)
    shutil.copy2(PACKAGE, scripts / PACKAGE.name)
    shutil.copy2(VERIFY, scripts / VERIFY.name)
    shutil.copy2(VERIFY_ISOLATED, scripts / VERIFY_ISOLATED.name)
    (root / "docs").mkdir()
    (root / "schemas").mkdir()
    (root / "LICENSE").write_text("fixture license\n", encoding="utf-8")
    (root / "README.md").write_text("fixture README\n", encoding="utf-8")
    (root / "docs/workflow-v1.md").write_text(REFERENCE, encoding="utf-8")
    (root / "schemas/workflow-v1.schema.json").write_text(SCHEMA, encoding="utf-8")
    return scripts / PACKAGE.name, scripts / VERIFY_ISOLATED.name, root / "um"


def archive(package_script: Path, binary: Path, output: Path) -> Path:
    run(
        [
            package_script,
            "--binary",
            binary,
            "--output",
            output,
            "--target",
            TARGET,
            "--version",
            VERSION,
        ]
    )
    return output / f"um-{VERSION}-{TARGET}.tar.gz"


def expect_verification_failure(verifier: Path, archive_path: Path, description: str) -> None:
    result = run(
        [
            verifier,
            "--archive",
            archive_path,
            "--target",
            TARGET,
            "--version",
            VERSION,
        ],
        check=False,
    )
    if result.returncode == 0:
        fail(f"{description} unexpectedly passed release-package verification")


# REQ-ONBOARD-2
def main() -> None:
    with tempfile.TemporaryDirectory(prefix="scherzo-release-package-test-") as temporary:
        root = Path(temporary)
        source = root / "source"
        package_script, verifier, binary = create_source(source)

        write_binary(binary, "none")
        first = archive(package_script, binary, root / "dist-first")
        second = archive(package_script, binary, root / "dist-second")
        if first.read_bytes() != second.read_bytes():
            fail("equivalent release packages are not deterministic")
        run(
            [
                verifier,
                "--archive",
                first,
                "--target",
                TARGET,
                "--version",
                VERSION,
            ]
        )

        write_binary(binary, "missing-command")
        missing_command = archive(package_script, binary, root / "dist-missing-command")
        expect_verification_failure(verifier, missing_command, "missing workflow command")

        write_binary(binary, "misleading-help")
        misleading_help = archive(package_script, binary, root / "dist-misleading-help")
        expect_verification_failure(
            verifier,
            misleading_help,
            "workflow commands absent from the help command inventory",
        )

        write_binary(binary, "source-dependent")
        source_dependent = archive(package_script, binary, root / "dist-source-dependent")
        expect_verification_failure(
            verifier,
            source_dependent,
            "source-dependent packaged authoring commands",
        )

        write_binary(binary, "schema-drift")
        schema_drift = archive(package_script, binary, root / "dist-schema-drift")
        expect_verification_failure(verifier, schema_drift, "mismatched embedded schema")

        write_binary(binary, "state-write")
        state_write = archive(package_script, binary, root / "dist-state-write")
        expect_verification_failure(
            verifier, state_write, "state-writing packaged authoring command"
        )

    print("CLI release-package authoring checks passed.")


if __name__ == "__main__":
    main()
