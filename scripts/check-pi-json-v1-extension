#!/usr/bin/env bash
set -euo pipefail

public_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
package_root=$public_root/crates/execution/src/workflow/pi-json-v1-extension

usage() {
  echo "usage: check-pi-json-v1-extension [--dependencies-only]" >&2
  exit 2
}

mode=check
case "${1:-}" in
  "") ;;
  --dependencies-only) mode=dependencies ;;
  *) usage ;;
esac
if [[ $# -gt 1 ]]; then
  usage
fi

check_root=$(mktemp -d "${TMPDIR:-/tmp}/um-pi-json-v1-check.XXXXXX")
cleanup() {
  rm -rf -- "$check_root"
}
trap cleanup EXIT

shopt -s dotglob nullglob
for entry in "$package_root"/*; do
  if [[ ${entry##*/} != node_modules ]]; then
    cp -R -- "$entry" "$check_root/"
  fi
done

(
  cd "$check_root"
  npm ci --ignore-scripts --no-audit --no-fund
  npm ls --all >/dev/null
  if [[ "$mode" == check ]]; then
    npm_config_offline=true npm run check
  fi
)
